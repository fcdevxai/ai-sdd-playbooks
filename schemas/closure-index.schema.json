{
  "$id": "https://playbook-ai.dev/schemas/closure-index.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Retained verification closure index",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "change_id",
    "verified_commit_sha",
    "reference_rebase",
    "files",
    "created_at"
  ],
  "properties": {
    "schema": {
      "const": "closure-index"
    },
    "schema_version": {
      "const": 1
    },
    "change_id": {
      "type": "string",
      "minLength": 1
    },
    "verified_commit_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "reference_rebase": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^openspec/changes/[a-z0-9._-]+/$"
        },
        "to": {
          "type": "string",
          "pattern": "^openspec/archive/[a-z0-9._-]+/$"
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "restricted_raw": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "original_reference",
          "reference",
          "sha256",
          "limitation"
        ],
        "properties": {
          "original_reference": {
            "type": "string",
            "pattern": "^\\.specloom/runs/[A-Za-z0-9._/-]+$"
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "limitation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "raw_root": {
      "type": "string",
      "minLength": 1
    }
  }
}
