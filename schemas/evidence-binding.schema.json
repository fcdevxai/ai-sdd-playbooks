{
  "$id": "https://playbook-ai.dev/schemas/evidence-binding.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit evidence-only commit lineage",
  "type": "object",
  "required": ["schema", "schema_version", "change_id", "repository", "report", "previous_commit_sha", "current_commit_sha", "governed_hash", "evidence_only_paths", "created_at"],
  "properties": {
    "schema": { "const": "evidence-binding" },
    "schema_version": { "const": 1 },
    "change_id": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "minLength": 1 },
    "report": { "type": "object", "required": ["repository", "path", "hash"], "properties": { "repository": { "type": "string", "minLength": 1 }, "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" }, "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
    "previous_commit_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "current_commit_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "governed_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evidence_only_paths": { "type": "array", "items": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" } },
    "supersedes": { "type": "array", "items": { "type": "object", "required": ["path", "sha256"], "properties": {
      "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
      "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } } },
    "equivalence": { "type": "object",
      "required": ["kind", "reviewed_tree_hash", "committed_tree_hash", "governed_paths_committed", "intervening_commits", "original_receipts"],
      "properties": {
        "kind": { "const": "identical-governed-content" },
        "reviewed_tree_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "committed_tree_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "governed_paths_committed": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" } },
        "intervening_commits": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-f0-9]{40}$" } },
        "original_receipts": { "type": "array", "items": { "type": "object", "required": ["repository", "path", "sha256"] } }
      } },
    "created_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" }
  }
}
