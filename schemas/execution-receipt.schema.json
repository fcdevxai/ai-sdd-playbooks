{
  "$id": "https://playbook-ai.dev/schemas/execution-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source-bound command execution receipt",
  "type": "object",
  "required": ["schema", "schema_version", "run_id", "change_id", "stage", "repository", "actor", "command", "environment", "started_at", "ended_at", "exit_code", "summary", "raw", "artifacts"],
  "properties": {
    "schema": { "const": "execution-receipt" },
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "change_id": { "type": "string", "minLength": 1 },
    "stage": { "type": "string", "minLength": 1 },
    "repository": { "type": "object", "required": ["name", "branch", "commit_sha", "source_hash"], "properties": { "name": { "type": "string", "minLength": 1 }, "branch": { "type": "string", "minLength": 1 }, "commit_sha": { "$ref": "#/$defs/commit" }, "source_hash": { "$ref": "#/$defs/hashOrUnknown" } } },
    "actor": { "type": "object", "required": ["agent", "provider", "model", "provenance", "identity_issues"], "properties": { "agent": { "type": "string", "minLength": 1 }, "provider": { "type": "string", "minLength": 1 }, "model": { "type": "string", "minLength": 1 }, "provenance": { "enum": ["runtime_observed", "caller_declared", "unavailable"] }, "identity_issues": { "type": "array", "items": { "type": "string" } } } },
    "command": { "type": "object", "required": ["argv", "cwd"], "properties": { "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "cwd": { "type": "string", "minLength": 1 } } },
    "environment": { "type": "object", "required": ["platform", "runtime", "container"], "properties": { "platform": { "type": "string", "minLength": 1 }, "runtime": { "type": "string", "minLength": 1 }, "container": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "started_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "ended_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "exit_code": { "type": "integer" },
    "signal": { "type": ["string", "null"] },
    "capture_error": { "type": ["string", "null"] },
    "summary": { "type": "string", "minLength": 1 },
    "raw": { "type": "object", "required": ["full"], "properties": { "stdout": { "$ref": "#/$defs/rawFile" }, "stderr": { "$ref": "#/$defs/rawFile" }, "full": { "$ref": "#/$defs/rawFile" } } },
    "artifacts": { "type": "object", "required": ["proposal_hash", "tasks_hash", "normative_tasks_hash", "contract_hashes"], "properties": { "proposal_hash": { "$ref": "#/$defs/hashOrUnknown" }, "tasks_hash": { "$ref": "#/$defs/hashOrUnknown" }, "normative_tasks_hash": { "$ref": "#/$defs/hashOrUnknown" }, "contract_hashes": { "type": "array", "items": { "type": "object", "required": ["path", "hash"], "properties": { "path": { "type": "string" }, "hash": { "$ref": "#/$defs/hash" } } } } } },
    "identity_issues": { "type": "array", "items": { "type": "string" } },
    "source_changed_during_run": { "type": "boolean" },
    "manifest_hash": { "$ref": "#/$defs/hashOrUnknown" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "hashOrUnknown": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "const": "unknown" }] },
    "commit": { "oneOf": [{ "type": "string", "pattern": "^[a-f0-9]{40}$" }, { "const": "unknown" }] },
    "rawFile": { "type": "object", "required": ["path", "bytes", "sha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "bytes": { "type": "integer", "minimum": 0 }, "sha256": { "$ref": "#/$defs/hash" } } }
  }
}
