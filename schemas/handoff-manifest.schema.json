{
  "$id": "https://playbook-ai.dev/schemas/handoff-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Versioned cross-agent handoff",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "change_id",
    "stage",
    "requirement",
    "spec",
    "acceptance_criteria",
    "error_cases",
    "security_criteria",
    "repositories",
    "design",
    "tasks",
    "contracts",
    "architecture",
    "required_skills",
    "required_tools",
    "runtime_coverage",
    "unresolved_risks",
    "blockers",
    "producer",
    "identity_issues",
    "created_at"
  ],
  "properties": {
    "schema": {
      "const": "handoff-manifest"
    },
    "schema_version": {
      "const": 1
    },
    "change_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "requirement": {
      "$ref": "#/$defs/reference"
    },
    "spec": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/criterion"
      }
    },
    "error_cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/criterion"
      }
    },
    "security_criteria": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/criterion"
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "branch",
          "commit_sha",
          "source_hash"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "branch": {
            "type": "string",
            "minLength": 1
          },
          "commit_sha": {
            "$ref": "#/$defs/commit"
          },
          "source_hash": {
            "$ref": "#/$defs/hash"
          },
          "tree_hash": {
            "$ref": "#/$defs/hash"
          }
        }
      }
    },
    "context_repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "branch",
          "commit_sha",
          "source_hash"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "branch": {
            "type": "string",
            "minLength": 1
          },
          "commit_sha": {
            "$ref": "#/$defs/commit"
          },
          "source_hash": {
            "$ref": "#/$defs/hash"
          },
          "tree_hash": {
            "$ref": "#/$defs/hash"
          }
        }
      }
    },
    "design": {
      "oneOf": [
        {
          "$ref": "#/$defs/reference"
        },
        {
          "type": "null"
        }
      ]
    },
    "design_not_applicable_reason": {
      "type": "string",
      "minLength": 1
    },
    "tasks": {
      "allOf": [
        {
          "$ref": "#/$defs/reference"
        },
        {
          "type": "object",
          "required": [
            "normative_hash"
          ],
          "properties": {
            "normative_hash": {
              "$ref": "#/$defs/hash"
            }
          }
        }
      ]
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "repository",
          "path",
          "content_hash"
        ],
        "properties": {
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "$ref": "#/$defs/path"
          },
          "content_hash": {
            "$ref": "#/$defs/hash"
          }
        }
      }
    },
    "architecture": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "required_skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "repository",
          "path",
          "hash"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "$ref": "#/$defs/path"
          },
          "hash": {
            "$ref": "#/$defs/hash"
          }
        }
      }
    },
    "required_tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "context",
          "purpose"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "runtime_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "criterion",
          "repositories",
          "capabilities"
        ],
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "repositories": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "browser",
                "http",
                "cli",
                "worker"
              ]
            }
          }
        }
      }
    },
    "unresolved_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "producer": {
      "type": "object",
      "required": [
        "agent",
        "provider",
        "model",
        "provenance"
      ],
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "enum": [
            "runtime_observed",
            "caller_declared",
            "unavailable"
          ]
        }
      }
    },
    "identity_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "non_runtime_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "criterion",
          "rationale"
        ],
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "reference": {
      "type": "object",
      "required": [
        "repository",
        "path",
        "hash"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "hash": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "criterion": {
      "type": "object",
      "required": [
        "id",
        "reference"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(AC|EC|SEC)-[A-Za-z0-9._-]+$"
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
