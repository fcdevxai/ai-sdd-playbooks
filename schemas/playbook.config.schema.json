{
  "$id": "https://playbook-ai.dev/schemas/playbook.config.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "playbook.config.yaml",
  "type": "object",
  "required": ["version", "methodology", "capabilities", "github"],
  "properties": {
    "version": { "const": 2 },
    "project": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "language": { "type": "string" }
      }
    },
    "methodology": {
      "type": "object",
      "required": ["compatible"],
      "properties": {
        "scope": { "enum": ["user", "project"] },
        "compatible": { "type": "string" }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "browser": { "type": "boolean" },
        "http": { "type": "boolean" },
        "cli": { "type": "boolean" },
        "worker": { "type": "boolean" }
      }
    },
    "design": {
      "type": "object",
      "properties": { "always": { "type": "boolean" } }
    },
    "security": {
      "type": "object",
      "properties": {
        "default_risk": { "enum": ["low", "standard", "elevated"] },
        "threat_model": { "enum": ["auto", "always", "never"] }
      }
    },
    "github": {
      "type": "object",
      "required": ["base_branch", "require_pull_request", "require_ci"],
      "properties": {
        "base_branch": { "type": "string" },
        "require_pull_request": { "const": true },
        "require_ci": { "const": true }
      }
    },
    "documents": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "addons": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "repos": {
      "type": "object",
      "description": "Optional multi-repo topology (additive; a single-repo project omits this entirely).",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "role": { "enum": ["sdd"] },
          "path": { "type": "string" },
          "stack": { "type": "string" },
          "default_base": { "type": "string" },
          "protected_paths": { "type": "array", "items": { "type": "string" } },
          "verification": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      }
    },
    "contract": {
      "type": "object",
      "properties": {
        "source_of_truth": { "type": "string" },
        "path_in_loom": { "type": "string" },
        "drift_check": { "type": "object" },
        "provided_by": { "type": "string" },
        "consumed_by": { "type": "array", "items": { "type": "string" } }
      }
    },
    "gating": {
      "type": "object",
      "properties": {
        "strategy": { "enum": ["per-feature"] }
      }
    }
  }
}
