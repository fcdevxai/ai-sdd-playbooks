{
  "$id": "https://playbook-ai.dev/schemas/proposal.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDD proposal artifact frontmatter",
  "type": "object",
  "required": ["schema", "schema_version", "change_id", "status", "impact", "security"],
  "properties": {
    "schema": { "const": "proposal" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "change_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "title": { "type": "string" },
    "status": { "enum": ["draft", "approved", "archived"] },
    "owner": { "type": "string" },
    "created": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "supersedes": { "type": "string" },
    "delivery": {
      "type": "object",
      "required": ["provider"],
      "properties": { "provider": { "const": "github" } }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_contract", "data_model", "architecture_boundary", "external_integration",
        "cross_repository", "authentication", "authorization", "infrastructure",
        "concurrency", "migration"
      ],
      "properties": {
        "public_contract": { "type": "boolean" },
        "data_model": { "type": "boolean" },
        "architecture_boundary": { "type": "boolean" },
        "external_integration": { "type": "boolean" },
        "cross_repository": { "type": "boolean" },
        "authentication": { "type": "boolean" },
        "authorization": { "type": "boolean" },
        "infrastructure": { "type": "boolean" },
        "concurrency": { "type": "boolean" },
        "migration": { "type": "boolean" }
      }
    },
    "security": {
      "type": "object",
      "required": ["risk", "triggers"],
      "properties": {
        "risk": { "enum": ["low", "standard", "elevated"] },
        "triggers": {
          "type": "array",
          "items": {
            "enum": [
              "authentication", "authorization", "roles_or_privileges", "tenant_boundary",
              "personal_data", "sensitive_data", "secrets", "file_upload", "external_integration",
              "payments", "infrastructure", "sensitive_logging", "ai_tool_execution",
              "critical_dependency"
            ]
          }
        }
      }
    },
    "runtime_relevant_capabilities": {
      "type": "array",
      "items": { "enum": ["browser", "http", "cli", "worker"] }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC-[0-9]{2,}$" },
          "text": { "type": "string" }
        }
      }
    }
  }
}
