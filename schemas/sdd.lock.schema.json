{
  "$id": "https://sdd.dev/schemas/sdd.lock.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sdd.lock",
  "type": "object",
  "required": ["version", "methodology"],
  "properties": {
    "version": { "const": 2 },
    "methodology": {
      "type": "object",
      "required": ["compatible"],
      "properties": {
        "compatible": { "type": "string" },
        "resolved": { "type": "string" }
      }
    },
    "installed_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "skills": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": { "version": { "type": "string" } }
      }
    },
    "capabilities_snapshot": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    }
  }
}
