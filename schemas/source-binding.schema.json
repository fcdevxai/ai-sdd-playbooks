{
  "$id": "https://playbook-ai.dev/schemas/source-binding.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gate source and execution evidence binding",
  "type": "object",
  "required": ["manifest_path", "manifest_hash", "governed_manifest_hash", "repositories", "proposal_hash", "design_hash", "normative_tasks_hash", "contract_hashes", "receipts", "delivery_state"],
  "properties": {
    "manifest_path": { "type": "string", "pattern": "^openspec/changes/[a-z0-9._-]+/handoff-manifest-sdd-[a-z-]+-[a-f0-9]{64}\\.json$" },
    "manifest_hash": { "$ref": "#/$defs/hash" },
    "governed_manifest_hash": { "$ref": "#/$defs/hash" },
    "repositories": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["name", "branch", "commit_sha", "source_hash"], "properties": {
      "name": { "type": "string", "minLength": 1 }, "branch": { "type": "string", "minLength": 1 },
      "commit_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" }, "source_hash": { "$ref": "#/$defs/hash" },
      "tree_hash": { "$ref": "#/$defs/hash" }
    } } },
    "proposal_hash": { "$ref": "#/$defs/hash" },
    "design_hash": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "const": "unknown" }] },
    "normative_tasks_hash": { "$ref": "#/$defs/hash" },
    "contract_hashes": { "type": "array", "items": { "type": "object", "required": ["path", "hash"], "properties": {
      "path": { "type": "string", "minLength": 1 }, "hash": { "$ref": "#/$defs/hash" }
    } } },
    "receipts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/receipt" } },
    "delivery_state": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "receipt": { "type": "object", "required": ["repository", "path", "sha256"], "properties": {
      "repository": { "type": "string", "minLength": 1 },
      "path": { "type": "string", "pattern": "^\\.specloom/runs/[A-Za-z0-9][A-Za-z0-9._-]*/execution-receipt\\.json$" },
      "sha256": { "$ref": "#/$defs/hash" }
    } }
  }
}
