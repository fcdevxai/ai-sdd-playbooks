{
  "$id": "https://playbook-ai.dev/schemas/tasks.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDD tasks artifact frontmatter",
  "type": "object",
  "required": ["schema", "schema_version", "change_id", "status"],
  "properties": {
    "schema": { "const": "tasks" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "change_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "title": { "type": "string" },
    "status": { "enum": ["draft", "ready", "in_progress", "passed", "blocked"] },
    "owner": { "type": "string" },
    "created": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "depends_on": { "type": "string" },
    "handoff": {
      "type": "object",
      "required": ["specs", "architecture", "contracts", "required_skills", "required_tools", "runtime_coverage", "unresolved_risks", "blockers"],
      "properties": {
        "specs": { "type": "array", "items": { "$ref": "#/$defs/repoReference" } },
        "architecture": { "type": "array", "items": { "$ref": "#/$defs/repoReference" } },
        "contracts": { "type": "array", "items": { "$ref": "#/$defs/repoReference" } },
        "required_skills": { "type": "array", "items": { "allOf": [{ "$ref": "#/$defs/repoReference" }, { "type": "object", "required": ["name"], "properties": { "name": { "type": "string", "minLength": 1 } } }] } },
        "required_tools": { "type": "array", "items": { "type": "object", "required": ["name", "context", "purpose"], "properties": { "name": { "type": "string", "minLength": 1 }, "context": { "type": "string", "minLength": 1 }, "purpose": { "type": "string", "minLength": 1 } } } },
        "runtime_coverage": { "type": "array", "items": { "type": "object", "required": ["criterion", "repositories", "capabilities"], "properties": { "criterion": { "type": "string", "minLength": 1 }, "repositories": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "capabilities": { "type": "array", "minItems": 1, "items": { "enum": ["browser", "http", "cli", "worker"] } } } } },
        "unresolved_risks": { "type": "array", "items": { "type": "string" } },
        "blockers": { "type": "array", "items": { "type": "string" } },
        "source_paths": { "type": "object", "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/path" } } },
        "context_repositories": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "$defs": {
    "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" },
    "repoReference": { "type": "object", "required": ["repository", "path"], "properties": { "repository": { "type": "string", "minLength": 1 }, "path": { "$ref": "#/$defs/path" } } }
  }
}
